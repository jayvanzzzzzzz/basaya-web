<?xml version="1.0" encoding="utf-8"?>
<!--
  The header (search, class chip, section title) scrolls away with the lesson list and slides
  back in on any upward scroll; the Lahat / Bukas / Sarado tabs stay pinned at the top.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context=".ui.fragment.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/homeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_bg"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <LinearLayout
                android:id="@+id/topSectionWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/home_bg"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="13dp"
                    android:autofillHints="name"
                    android:background="@drawable/bg_dashboard_search"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:hint="@string/maghanap_dito_ng_paksa"
                    android:inputType="text"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="@color/home_ink"
                    android:textColorHint="@color/home_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dashboard_class"
                android:drawableStart="@drawable/ic_book"
                android:drawablePadding="7dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:textColor="@color/home_class_fg"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topSectionWrapper"
                tools:text="Masayang Pagbasa" />

            <TextView
                android:id="@+id/tvSectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/lexend"
                android:text="@string/dashboard_lessons_title"
                android:textColor="@color/home_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnRefresh"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvClassName" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_dashboard_refresh"
                android:contentDescription="@string/refresh_lessons"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvClassName"
                app:tint="@color/home_accent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="8dp"
            app:layout_scrollFlags="scroll"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadAll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/lesson_card_primary"
            android:text="@string/lesson_download_all"
            android:textAllCaps="false"
            android:textColor="@color/lesson_card_primary"
            android:visibility="gone"
            app:strokeColor="@color/lesson_card_stroke" />
            <ImageButton
                android:id="@+id/btnCancelDownloadAll"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/lesson_download_cancel_cd"
                android:visibility="gone"
                app:tint="@color/lesson_card_primary" />
        </LinearLayout>

        <!-- Lahat / Bukas / Sarado. Shown once the class has lessons. Pinned: no scroll flags. -->
        <HorizontalScrollView
            android:id="@+id/lessonTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lesson_tabs"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tabAll"
                style="@style/LessonTab"
                android:layout_width="wrap_content"
                android:minWidth="80dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                tools:text="Lahat (5)" />

            <TextView
                android:id="@+id/tabOpen"
                style="@style/LessonTab"
                android:layout_width="wrap_content"
                android:minWidth="80dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                    tools:text="Bukas (3)" />

            <TextView
                android:id="@+id/tabClosed"
                style="@style/LessonTab"
                android:layout_width="wrap_content"
                android:minWidth="80dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                    tools:text="Sarado (2)" />
            <TextView
                android:id="@+id/tabDownloaded"
                style="@style/LessonTab"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="4dp"
                tools:text="Na-download (2)" />
        </LinearLayout>
        </HorizontalScrollView>

        <!-- Lahat / Tapos na / Nasa progreso / Hindi pa nasisimulan, combined with the tabs above. The chips are added in HomeFragment. Shown with the tabs. -->
        <HorizontalScrollView
            android:id="@+id/statusFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/llStatusFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLessons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_lesson" />

        <!--
          Empty state lives in its own scroll area below the header: centered when it fits,
          scrollable when the screen is short, so the message is never clipped and never
          overlaps the section label or refresh button. Shown/hidden with tvEmptyLessons.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyStateScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="16dp"
            android:paddingBottom="88dp"
            android:scrollbars="none"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvEmptyLessons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="34dp"
                    android:background="@drawable/bg_home_empty_state"
                    android:drawableTop="@drawable/ic_empty_lessons"
                    android:drawablePadding="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="24dp"
                    android:text="@string/empty_no_lessons"
                    android:textColor="@color/home_body"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/dot_circle" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/dot_circle" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_circle" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/dashboard_loading_lessons"
                android:textColor="@color/home_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnJoinClass"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_join_class_action"
        android:contentDescription="@string/cta_add_class_description"
        android:elevation="8dp"
        android:padding="15dp"
        android:src="@drawable/ic_join_class"
        app:tint="#FFFFFF" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
