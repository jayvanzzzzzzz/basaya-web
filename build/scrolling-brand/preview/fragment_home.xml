<?xml version="1.0" encoding="utf-8"?>
<!-- Compact lesson controls; secondary filters live in a sheet. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context=".ui.fragment.HomeFragment">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/homeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_bg"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <include
            layout="@layout/include_scrolling_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll" />
        <LinearLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvSectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/lexend"
                    android:text="@string/home_lessons_heading"
                    android:textColor="@color/home_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/btnSearchLessons"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_search_toggle"
                    android:padding="13dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/home_body" />
                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_options"
                    android:padding="13dp"
                    android:src="@drawable/ic_lesson_more"
                    app:tint="@color/home_body" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_regular"
                android:textColor="@color/home_body"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Grade 7 · Aguinaldo"
                tools:visibility="visible" />
            <FrameLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">
                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:background="@drawable/bg_home_search"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/home_body"
                    android:hint="@string/maghanap_dito_ng_paksa"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="@color/home_ink"
                    android:textColorHint="@color/home_hint"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
        <!-- Visible only while a bulk download is running. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_scrollFlags="scroll">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/lesson_download_all"
                android:textAllCaps="false"
                android:textColor="@color/home_accent"
                android:visibility="gone"
                app:strokeColor="@color/home_stroke" />
            <ImageButton
                android:id="@+id/btnCancelDownloadAll"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lesson_download_cancel_cd"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/home_accent" />
        </LinearLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/lessonTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:flexWrap="wrap"
            app:alignItems="center"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                app:layout_flexGrow="1"
                app:layout_flexBasisPercent="72%"
                android:background="@drawable/bg_lesson_tabs"
                android:gravity="center_vertical"
                android:paddingBottom="1dp">
                <TextView
                    android:id="@+id/tabAll"
                    style="@style/LessonTab"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    tools:text="Lahat (12)" />
                <TextView
                    android:id="@+id/tabDownloaded"
                    style="@style/LessonTab"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    tools:text="Na-download (4)" />
            </LinearLayout>
            <TextView
                android:id="@+id/btnLessonFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_filter_action"
                android:clickable="true"
                android:focusable="true"
                android:drawableStart="@drawable/ic_home_filter"
                android:drawablePadding="6dp"
                android:drawableTint="@color/home_accent"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/home_filter"
                android:textColor="@color/home_accent"
                android:textSize="12sp" />
        </com.google.android.flexbox.FlexboxLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLessons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_lesson" />
        <!--
          Empty state lives in its own scroll area below the header: centered when it fits,
          scrollable when the screen is short, so the message is never clipped and never
          overlaps the section label or refresh button. Shown/hidden with tvEmptyLessons.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyStateScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="16dp"
            android:paddingBottom="88dp"
            android:scrollbars="none"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvEmptyLessons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="34dp"
                    android:background="@drawable/bg_home_empty_state"
                    android:drawableTop="@drawable/ic_empty_lessons"
                    android:drawablePadding="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="24dp"
                    android:text="@string/empty_no_lessons"
                    android:textColor="@color/home_body"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">
                <View
                    android:id="@+id/dot1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/dot_circle" />
                <View
                    android:id="@+id/dot2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/dot_circle" />
                <View
                    android:id="@+id/dot3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_circle" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/dashboard_loading_lessons"
                android:textColor="@color/home_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
    <ImageButton
        android:id="@+id/btnJoinClass"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_join_class_action"
        android:contentDescription="@string/cta_add_class_description"
        android:elevation="2dp"
        android:padding="15dp"
        android:src="@drawable/ic_join_class"
        app:tint="@color/home_on_action" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
