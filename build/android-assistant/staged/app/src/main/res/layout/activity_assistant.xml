<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistantRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/assistant_bg" android:paddingBottom="12dp" android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/assistantToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="8dp" android:paddingEnd="16dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/assistantBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/cw_ic_back"
            android:contentDescription="@string/assistant_back" android:padding="13dp" app:tint="@color/assistant_ink"/>
        <TextView android:id="@+id/assistantPageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/assistant_title" android:textColor="@color/assistant_ink" android:textSize="26sp" android:letterSpacing="-0.04"
            android:fontFamily="@font/lexend" android:textStyle="bold" android:accessibilityHeading="true"/>
    </LinearLayout>
    <TextView android:id="@+id/assistantPageDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/assistant_page_description" android:textColor="@color/assistant_soft" android:textSize="14sp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp" android:visibility="gone"/>
    <com.google.android.material.card.MaterialCardView android:id="@+id/assistantCard" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/assistant_border"
        app:cardBackgroundColor="@color/assistant_surface" android:clipToOutline="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:padding="12dp" android:background="@color/assistant_surface">
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_chat"
                    android:padding="9dp" android:background="@drawable/bg_assistant_badge" app:tint="@color/assistant_primary" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <com.google.android.flexbox.FlexboxLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:flexWrap="wrap" app:alignItems="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/assistant_title"
                            android:textColor="@color/assistant_ink" android:textSize="14sp" android:fontFamily="@font/lexend" android:textStyle="bold" app:layout_flexShrink="1"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI" android:textSize="10sp"
                            android:textColor="@color/assistant_primary" android:fontFamily="@font/be_vietnam_semi_bold" android:background="@drawable/bg_assistant_badge"
                            android:layout_marginStart="5dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
                    </com.google.android.flexbox.FlexboxLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                            android:text="@string/assistant_subtitle" android:textColor="@color/assistant_soft" android:textSize="11sp" android:fontFamily="@font/be_vietnam_regular"/>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView android:id="@+id/assistantGuides" android:layout_width="48dp" android:layout_height="48dp"
                    android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_guides"
                    app:cardCornerRadius="13dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/assistant_border"
                    app:cardBackgroundColor="@color/assistant_chat_bg" app:rippleColor="@color/assistant_tint">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_assistant_info"
                        android:padding="11dp" app:tint="@color/assistant_soft" android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/assistant_border"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/assistantConversation" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <androidx.core.widget.NestedScrollView android:id="@+id/assistantScroll" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:fillViewport="true" android:background="@color/assistant_chat_bg" android:clipToPadding="false">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <LinearLayout android:id="@+id/assistantMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            <LinearLayout android:id="@+id/assistantSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="vertical" android:layout_marginTop="20dp">
                                <LinearLayout android:id="@+id/assistantQuestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                    <TextView android:id="@+id/assistantStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:background="@color/assistant_chat_bg" android:textColor="@color/assistant_soft" android:textSize="12sp"
                        android:fontFamily="@font/be_vietnam_regular" android:visibility="gone"/>
                    <TextView android:id="@+id/assistantRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/assistant_retry" android:textColor="@color/assistant_primary" android:textSize="12sp" android:gravity="center"
                        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/assistant_border"/>
                    <LinearLayout android:id="@+id/assistantComposer" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:orientation="vertical" android:background="@color/assistant_surface">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom">
                            <EditText android:id="@+id/assistantInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:minHeight="64dp" android:maxLines="5" android:maxLength="500" android:saveEnabled="false"
                                android:gravity="top|start" android:padding="12dp" android:background="@drawable/bg_assistant_input"
                                android:hint="@string/assistant_hint" android:contentDescription="@string/assistant_input_label" android:textSize="14sp"
                                android:textColor="@color/assistant_ink" android:textColorHint="@color/assistant_muted" android:fontFamily="@font/be_vietnam_regular"
                                android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"/>
                            <LinearLayout android:id="@+id/assistantSend" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minHeight="48dp" android:minWidth="48dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                                android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/bg_assistant_send"
                                android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_send">
                                <ImageView android:id="@+id/assistantSendIcon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_assistant_send"
                                    android:importantForAccessibility="no"/>
                                <TextView android:id="@+id/assistantSendLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/assistant_send" android:textColor="@color/assistant_on_primary" android:textSize="12sp"
                                    android:layout_marginStart="6dp" android:fontFamily="@font/be_vietnam_semi_bold"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/assistantCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="end" android:visibility="gone" android:textSize="11sp" android:textColor="@color/assistant_muted"/>
                    </LinearLayout>
                    <com.google.android.flexbox.FlexboxLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp" app:flexWrap="wrap" app:justifyContent="space_between">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/assistant_privacy"
                            android:textColor="@color/assistant_muted" android:textSize="11sp" android:fontFamily="@font/be_vietnam_regular"/>
                        <TextView android:id="@+id/assistantQuota" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" app:layout_flexGrow="1" android:gravity="end"
                            android:textColor="@color/assistant_soft" android:textSize="11sp" android:fontFamily="@font/be_vietnam_regular"/>
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>
                <androidx.core.widget.NestedScrollView android:id="@+id/assistantHelp" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@color/assistant_surface" android:visibility="gone" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:focusableInTouchMode="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_guides_title" android:textSize="21sp"
                            android:textColor="@color/assistant_ink" android:fontFamily="@font/lexend" android:accessibilityHeading="true"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_guides_subtitle" android:textSize="13sp"
                            android:textColor="@color/assistant_soft" android:layout_marginTop="8dp" android:fontFamily="@font/be_vietnam_regular"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_search_label" android:textSize="12sp"
                            android:textColor="@color/assistant_soft" android:layout_marginTop="20dp" android:labelFor="@id/assistantSearch"/>
                        <EditText android:id="@+id/assistantSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                            android:background="@drawable/bg_assistant_input" android:hint="@string/assistant_search_hint" android:layout_marginTop="6dp" android:padding="12dp"
                            android:textSize="14sp" android:textColor="@color/assistant_ink" android:textColorHint="@color/assistant_muted" android:inputType="text"
                            android:singleLine="true" android:saveEnabled="false" android:imeOptions="actionSearch"/>
                        <LinearLayout android:id="@+id/assistantArticles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                        <TextView android:id="@+id/assistantNoHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_no_help"
                            android:textSize="13sp" android:textColor="@color/assistant_soft" android:paddingTop="12dp" android:visibility="gone"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_disclaimer" android:layout_marginTop="16dp"
                            android:textSize="13sp" android:textColor="@color/assistant_soft" android:fontFamily="@font/be_vietnam_regular" android:lineSpacingExtra="6dp"/>
                        <TextView android:id="@+id/assistantClassChat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                            android:text="Class Chat →" android:textSize="13sp" android:textColor="@color/assistant_primary" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
