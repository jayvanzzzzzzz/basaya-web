<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistantRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/assistant_bg" android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/assistantToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:gravity="center_vertical" android:background="@color/assistant_blue">
        <ImageButton android:id="@+id/assistantBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/cw_ic_back"
            android:contentDescription="@string/assistant_back" android:padding="12dp" app:tint="@color/assistant_on_blue"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/assistant_title" android:textColor="@color/assistant_on_blue" android:textSize="18sp"
            android:fontFamily="@font/lexend" android:paddingStart="8dp" android:paddingEnd="8dp" android:accessibilityHeading="true"/>
        <ImageButton android:id="@+id/assistantGuides" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_assistant_guide"
            android:contentDescription="@string/assistant_guides" android:padding="12dp"
            android:stateListAnimator="@animator/masthead_press"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/assistantScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout android:id="@+id/assistantHero" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_assistant_hero">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/assistant_kicker" android:textSize="10sp" android:letterSpacing="0.12"
                    android:textColor="@color/assistant_hero_soft" android:fontFamily="@font/be_vietnam_bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/assistant_hero" android:textColor="@color/assistant_on_blue" android:textSize="24sp"
                        android:lineSpacingExtra="2dp" android:fontFamily="@font/lexend" android:textStyle="bold"/>
                    <ImageView android:id="@+id/assistantBuddy" android:layout_width="88dp" android:layout_height="104dp"
                        android:layout_marginStart="8dp" android:src="@drawable/assistant_buddy" android:importantForAccessibility="no"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/assistant_subtitle" android:textSize="13sp"
                    android:textColor="@color/assistant_hero_soft" android:fontFamily="@font/be_vietnam_regular"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/assistant_badge" android:textSize="10sp"
                    android:textColor="@color/assistant_mint_ink" android:fontFamily="@font/be_vietnam_bold"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:background="@drawable/bg_assistant_badge"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/assistantSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_start"
                    android:textColor="@color/assistant_ink" android:fontFamily="@font/lexend" android:textSize="17sp" android:accessibilityHeading="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/assistant_suggestion_hint" android:textColor="@color/assistant_soft" android:textSize="12sp"
                    android:fontFamily="@font/be_vietnam_regular"/>
                <com.google.android.flexbox.FlexboxLayout android:id="@+id/assistantQuestions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" app:flexWrap="wrap"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/assistantMessages" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/assistantPending" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:padding="16dp" android:visibility="gone"
                android:background="@drawable/bg_assistant_surface">
                <ProgressBar android:layout_width="20dp" android:layout_height="20dp" android:indeterminateTint="@color/home_accent"
                    android:importantForAccessibility="no"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                    android:text="@string/assistant_thinking" android:textColor="@color/assistant_soft" android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_regular" android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/assistant_disclaimer" android:textColor="@color/assistant_soft" android:textSize="11sp"
                android:fontFamily="@font/be_vietnam_regular" android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/assistantComposer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
        android:background="@color/assistant_surface">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/assistantStatus" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:textColor="@color/assistant_soft" android:textSize="12sp" android:fontFamily="@font/be_vietnam_regular"/>
            <ImageButton android:id="@+id/assistantRetry" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_assistant_refresh" android:padding="13dp" app:tint="@color/home_accent"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/assistant_retry"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom"
            android:background="@drawable/bg_assistant_surface" android:padding="6dp">
            <EditText android:id="@+id/assistantInput" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:maxLines="4" android:maxLength="500" android:saveEnabled="false"
                android:gravity="top|start" android:padding="10dp" android:background="@android:color/transparent"
                android:hint="@string/assistant_hint" android:contentDescription="@string/assistant_input_label" android:textSize="14sp"
                android:textColor="@color/assistant_ink" android:textColorHint="@color/assistant_soft"
                android:fontFamily="@font/be_vietnam_regular" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"/>
            <ImageButton android:id="@+id/assistantSend" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_assistant_send" android:src="@drawable/ic_assistant_send" android:padding="13dp"
                android:contentDescription="@string/assistant_send" android:stateListAnimator="@animator/masthead_press"/>
        </LinearLayout>
        <TextView android:id="@+id/assistantCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:visibility="gone" android:textSize="11sp" android:textColor="@color/assistant_soft"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/assistantQuota" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/home_accent" android:textSize="11sp" android:fontFamily="@font/be_vietnam_semi_bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_privacy"
                android:layout_marginTop="3dp" android:textColor="@color/assistant_soft" android:textSize="10sp" android:fontFamily="@font/be_vietnam_regular"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
