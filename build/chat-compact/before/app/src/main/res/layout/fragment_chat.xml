<?xml version="1.0" encoding="utf-8"?>
<!-- Class chat: header card, messages, closed banner and composer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".ui.fragment.ChatFragment">
    <!-- Header: class tile, title and class name -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ch_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">
        <TextView
            android:id="@+id/tvClassTile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ch_class_tile"
            android:fontFamily="@font/lexend"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingBottom="0dp"
            android:textColor="@color/ch_on_action"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="G4" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/lexend"
                android:text="@string/ch_title"
                android:textColor="@color/ch_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvChatClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:textColor="@color/ch_ink_soft"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Grade 4 - Sampaguita"
                tools:visibility="visible"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <!-- Class members: teacher on top, students A–Z (sheet_class_members). -->
        <ImageButton
            android:id="@+id/btnMembers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ch_info_button"
            android:contentDescription="@string/ch_members"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            android:tooltipText="@string/ch_members"
            android:visibility="gone"
            app:tint="@color/ch_ink_soft"
            tools:visibility="visible"
            android:stateListAnimator="@animator/chat_press" />
    </LinearLayout>
    <!-- Messages, or the empty / no-class / loading state -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/chatEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:scrollbars="none">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    tools:visibility="visible"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">
                    <ImageView
                        android:id="@+id/ivEmptyIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/ch_empty_icon"
                        android:importantForAccessibility="no"
                        android:padding="16dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/ch_accent" />
                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/lexend"
                        android:gravity="center"
                        android:text="@string/ch_empty_title"
                        android:textColor="@color/ch_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvEmptyBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/be_vietnam_regular"
                        android:gravity="center"
                        android:text="@string/ch_empty_body"
                        android:textColor="@color/ch_ink_soft"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar
            android:id="@+id/chatLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ch_accent"
            android:visibility="gone" />
        <!-- "Go to newest": shown once scrolled up, with a count of messages that came in meanwhile. -->
        <FrameLayout
            android:id="@+id/jumpToNewest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            tools:visibility="visible">
            <ImageButton
                android:id="@+id/btnJumpToNewest"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ch_jump"
                android:contentDescription="@string/ch_jump"
                android:elevation="1dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chat_down"
                app:tint="@color/ch_ink_soft"
                android:padding="12dp"
                android:stateListAnimator="@animator/chat_press" />
            <TextView
                android:id="@+id/tvJumpCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/ch_jump_badge"
                android:elevation="4dp"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/ch_on_action"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible"
                android:minHeight="20dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </FrameLayout>
    </FrameLayout>
    <!-- Closed by the teacher: read only -->
    <TextView
        android:id="@+id/tvClosedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ch_closed_banner"
        android:fontFamily="@font/be_vietnam_semi_bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/ch_closed_banner"
        android:textColor="@color/ch_closed"
        android:textSize="13sp"
        android:visibility="gone" />
    <!-- Composer -->
    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/ch_composer_panel"
        android:paddingTop="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ch_composer"
            android:orientation="vertical">
            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/be_vietnam_regular"
                android:hint="@string/ch_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:maxLines="5"
                android:minHeight="52dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:textColor="@color/ch_ink"
                android:textColorHint="@color/ch_ink_soft"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />
            <TextView
                android:id="@+id/tvCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:importantForAccessibility="no"
                android:textColor="@color/ch_ink_soft"
                android:textSize="11sp"
                android:visibility="gone"
                tools:ignore="SmallSp"
                tools:text="256/300"
                tools:visibility="visible"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp">
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ch_send"
                android:contentDescription="@string/ch_send"
                android:enabled="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                android:stateListAnimator="@animator/chat_press"
                android:padding="14dp"
                app:tint="@color/ch_send_icon" />
            <!-- Seconds left before the next send (5-second limit). -->
            <TextView
                android:id="@+id/tvCooldown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/ch_on_action"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="4" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>