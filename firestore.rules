rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "teacher";
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "admin";
    }

    function teachesClass(classId) {
      return classId != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId))
          .data.teacherId == request.auth.uid;
    }

    // Lesson schedule: the teacher's optional openAt/dueAt on
    // classes/{classId}/classLessons/{lessonId}. Judged by server time
    // (request.time), so changing the phone's date does not help.
    function scheduleAllows(link) {
      return (link.get('openAt', null) == null || request.time >= link.openAt) &&
        (link.get('dueAt', null) == null || request.time <= link.dueAt);
    }

    // A Practice lesson (link mode "practice") never saves progress: students can redo it
    // as often as they like and the teacher's reports leave it out. A lesson can be in a
    // class twice: as an Assessment (link id = lesson id) and as Practice
    // (link id = "{lessonId}__practice"). Progress is only for the Assessment.
    function classLessonAllows(classId, lessonId) {
      let path = /databases/$(database)/documents/classes/$(classId)/classLessons/$(lessonId);
      let practicePath = /databases/$(database)/documents/classes/$(classId)/classLessons/$(lessonId + '__practice');
      return (exists(path) && scheduleAllows(get(path).data) &&
          get(path).data.get('mode', 'assessment') != 'practice') ||
        // Older links have auto-generated ids and no schedule; a lesson that is only in
        // the class as Practice saves nothing.
        (!exists(path) && !exists(practicePath));
    }

    function lessonIsOpen(userId, lessonId) {
      let classId = get(/databases/$(database)/documents/users/$(userId))
        .data.get('classId', null);
      return classId == null || classId == "" || classLessonAllows(classId, lessonId);
    }

    // A student can't switch or leave a class while still on its roster: leaving needs the
    // teacher's approval (notify-api/api/remove-student clears classId).
    function classChangeAllowed(userId) {
      let before = resource.data.get('classId', null);
      let after = request.resource.data.get('classId', null);
      return before == after || before == null || before == "" ||
        !exists(/databases/$(database)/documents/classes/$(before)/students/$(userId));
    }

    // The teacher of the class the signed-in student is on the roster of (the chat's
    // member list shows the teacher's name; a removed teacher's doc reads as missing).
    function teachesMyClass(teacherId) {
      let myClass = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('classId', '');
      return myClass is string && myClass != '' &&
        exists(/databases/$(database)/documents/classes/$(myClass)/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/classes/$(myClass)).data.get('teacherId', '') == teacherId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTeacher() && teachesClass(resource.data.get('classId', null))) ||
        ((resource == null || resource.data.get('role', '') == "teacher") && teachesMyClass(userId))
      );

      allow create: if signedIn() && (                                                                                                                                            
          (request.auth.uid == userId &&                                                                                                                                            
            request.resource.data.role == "student") ||                                                                                                                             
          isAdmin()                                                                                                                                                                 
        );                                                                                                                                                                          
                                                                                                                                                                                    
        allow update: if signedIn() && (
          isAdmin() ||
          (request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            classChangeAllowed(userId))
        );
                                                                                                                                                                                    
        allow delete: if isAdmin();    

      match /assignedLessons/{lessonId} {
        allow read: if signedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (isTeacher() &&
            teachesClass(
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('classId', null)
            ))
        );

        // Progress is rejected before the lesson opens and after its deadline.
        allow write: if signedIn() && request.auth.uid == userId &&
          lessonIsOpen(userId, lessonId);
      }
    }

    // All authenticated users can read lessons.
    // Only administrators can create, edit, or delete lessons
    // and their activity/lectures/pronunciation/quiz/game content.
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
    }

    match /classes/{classId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.teacherId == request.auth.uid;

      // The class's teacher or an admin can edit it (a teacher also uses this to
      // request deletion: deletionRequest / deletionDeclined fields).
      allow update: if signedIn() &&
        (resource.data.teacherId == request.auth.uid || isAdmin());

      // Never deleted directly: an admin approves, then notify-api/api/delete-class
      // removes the class with its roster, lessons and every student's progress.
      allow delete: if false;

      match /students/{studentId} {
        allow read: if signedIn() &&
          (request.auth.uid == studentId ||
           isAdmin() ||
           get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));

        // Joining: a student adds themselves.
        allow create: if signedIn() && request.auth.uid == studentId;

        // The student may rename themselves and ask to leave (or cancel); the class's
        // teacher may decline a leave request.
        allow update: if signedIn() && (
          (request.auth.uid == studentId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'joinedAt', 'leaveRequest', 'leaveDeclined'])) ||
          (teachesClass(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leaveRequest', 'leaveDeclined']))
        );

        // Leaving only happens when the teacher approves (notify-api/api/remove-student).
        allow delete: if false;
      }

      // Notification list ("new lesson"), written only by notify-api (Admin SDK).
      match /notifications/{notificationId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));
        allow write: if false;
      }

      // ---------- Class chat: one group chat for the teacher and the class's students ----------
      // messages/{id}   text, senderId, senderName, role ("teacher" | "student"), sentAt;
      //                 a removed message keeps its place: text "", deleted true, deletedBy.
      // chat/state      open (missing = open) and a summary of the last message (lastAt,
      //                 lastText, lastSenderName, lastRole), so unread badges cost one read.
      // chatSenders/{uid}  lastSentAt: a student's last send, for the 5-second limit.
      // A student sends with one batch: the message, chatSenders/{uid} and chat/state.

      function isChatMember(classId) {
        return exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid));
      }

      function chatOpen(classId) {
        let state = /databases/$(database)/documents/classes/$(classId)/chat/state;
        return !exists(state) || get(state).data.get('open', true) == true;
      }

      // The student's chatSenders doc is stamped with this request's time in the same batch.
      function sentNow(classId) {
        return getAfter(/databases/$(database)/documents/classes/$(classId)/chatSenders/$(request.auth.uid))
          .data.lastSentAt == request.time;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'role', 'sentAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.sentAt == request.time &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.senderName is string &&
          (
            (request.resource.data.role == "teacher" &&
              teachesClass(classId) &&
              request.resource.data.text.size() <= 2000 &&
              request.resource.data.senderName.size() <= 80) ||
            (request.resource.data.role == "student" &&
              isChatMember(classId) &&
              chatOpen(classId) &&
              request.resource.data.text.size() <= 300 &&
              request.resource.data.senderName ==
                get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
                  .data.get('fullName', '') &&
              sentNow(classId))
          );

        // Removing: the teacher, any message; a student, their own within 5 minutes.
        allow update: if signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'deletedBy']) &&
          request.resource.data.text == "" &&
          request.resource.data.deleted == true &&
          (
            (teachesClass(classId) && request.resource.data.deletedBy == "teacher") ||
            (resource.data.senderId == request.auth.uid &&
              request.resource.data.deletedBy == "sender" &&
              request.time < resource.data.sentAt + duration.value(5, 'm'))
          );

        allow delete: if false;
      }

      match /chat/{stateId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        // The teacher opens/closes the chat and updates the summary when posting.
        allow create, update: if signedIn() && stateId == "state" && (
          (teachesClass(classId) &&
            request.resource.data.keys().hasOnly(['open', 'lastAt', 'lastText', 'lastSenderName', 'lastRole']) &&
            (request.resource.data.get('open', true) is bool)) ||
          // A student only updates the summary, alongside a message (see sentNow).
          (isChatMember(classId) &&
            (resource == null
              ? request.resource.data.keys().hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])) &&
            request.resource.data.lastAt == request.time &&
            request.resource.data.lastRole == "student" &&
            request.resource.data.lastText is string &&
            request.resource.data.lastText.size() <= 300 &&
            chatOpen(classId) &&
            sentNow(classId))
        );
        allow delete: if false;
      }

      match /chatSenders/{senderId} {
        allow read: if signedIn() && request.auth.uid == senderId;

        // Stamped with the server's time; at least 5 seconds after the last one.
        allow create, update: if signedIn() &&
          request.auth.uid == senderId &&
          isChatMember(classId) &&
          request.resource.data.keys().hasOnly(['lastSentAt']) &&
          request.resource.data.lastSentAt == request.time &&
          (resource == null || request.time >= resource.data.lastSentAt + duration.value(5, 's'));
        allow delete: if false;
      }

      // Teachers can add an existing lesson only to a class they own.
      // Admins can read them to see which classes use a lesson (lesson editor).
      match /classLessons/{lessonId} {
        allow read: if signedIn() &&
          (isAdmin() ||
           get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));

        allow write: if signedIn() &&
          get(/databases/$(database)/documents/classes/$(classId))
            .data.teacherId == request.auth.uid;
      }
    }

    match /classLessons/{linkId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      allow delete: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow write: if false;
    }

    // Diksiyonaryo: words teachers add or fix (js/dictionary.js). The doc id is the
    // search key; `hidden: true` takes a Wiktionary seed word out, and `syllables` ("ba·hay")
    // fixes the automatic syllable split (js/syllables.js). Everyone signed in
    // reads, any teacher or admin adds/edits, and only whoever added a word (or an
    // admin) deletes it. Any teacher may delete a "hidden" marker (shows the word again).
    match /dictionary/{key} {
      function validWord() {
        let d = request.resource.data;
        return d.keys().hasOnly(["word", "key", "accent", "syllables", "senses", "synonyms", "hidden",
            "createdBy", "createdByName", "createdAt", "updatedBy", "updatedByName", "updatedAt"]) &&
          d.word is string && d.word.size() > 0 && d.word.size() <= 60 &&
          d.key == key &&
          d.accent is string && d.accent.size() <= 60 &&
          (!("syllables" in d) || (d.syllables is string && d.syllables.size() <= 120)) &&
          d.senses is list && d.senses.size() <= 5 &&
          (d.hidden || d.senses.size() > 0) &&
          d.synonyms is list && d.synonyms.size() <= 10 &&
          d.hidden is bool &&
          d.createdByName is string && d.createdByName.size() <= 120 &&
          d.updatedBy == request.auth.uid &&
          d.updatedByName is string && d.updatedByName.size() <= 120 &&
          d.updatedAt == request.time;
      }

      allow read: if signedIn();

      allow create: if (isTeacher() || isAdmin()) && validWord() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      allow update: if (isTeacher() || isAdmin()) && validWord() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin() ||
        (isTeacher() && (resource.data.createdBy == request.auth.uid || resource.data.hidden == true));
    }

    // adminPasswordChanges (admin password changes waiting for email approval) has
    // no rule on purpose: only notify-api reads and writes it, with the Admin SDK.
  }
}