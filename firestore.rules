rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function authenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return authenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "teacher" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('emailVerificationRequired', false) != true ||
          (request.auth.token.get('email_verified', false) == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mustChangePassword', false) != true));
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "admin";
    }

    function teachesClass(classId) {
      return isTeacher() && classId != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId))
          .data.teacherId == request.auth.uid;
    }

    function teachesActiveClass(classId) {
      return teachesClass(classId) && get(/databases/$(database)/documents/classes/$(classId)).data.get('membershipClosed', false) != true;
    }

    function activeClassTeacher(teacherId) {
      return teacherId == '' || (teacherId is string &&
        get(/databases/$(database)/documents/users/$(teacherId)).data.get('role', '') == 'teacher' &&
        get(/databases/$(database)/documents/users/$(teacherId)).data.get('disabled', false) != true);
    }

    // Approval is represented by BOTH the server-owned profile link and roster entry.
    function isClassMember(classId) {
      return signedIn() && classId is string && classId != '' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classId', '') == classId &&
        exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid));
    }

    function canParticipate(classId) {
      return isClassMember(classId) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.get('membershipClosed', false) != true &&
        get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)).data.get('membershipStatus', 'enrolled') != 'dropped';
    }

    function canReadLearningContent() {
      return signedIn() && (isTeacher() || isAdmin() ||
        canParticipate(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classId', '')));
    }

    // Assessment membership, explicit assignments and server-time schedules are
    // checked by the API; clients cannot write progress directly.

    // The teacher of the class the signed-in student is on the roster of (the chat's member list shows the teacher's name; a removed teacher's doc reads as missing).
    function teachesMyClass(teacherId) {
      let myClass = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('classId', '');
      return myClass is string && myClass != '' &&
        isClassMember(myClass) &&
        get(/databases/$(database)/documents/classes/$(myClass)).data.get('teacherId', '') == teacherId;
    }

    match /users/{userId} {
      // Keep the own profile readable so a deactivated session can detect the
      // access change and sign out; other protected reads require active access.
      allow read: if authenticated() && request.auth.uid == userId || signedIn() && (
        isAdmin() ||
        (isTeacher() && teachesClass(resource.data.get('classId', null))) ||
        ((resource == null || resource.data.get('role', '') == "teacher") && teachesMyClass(userId))
      );

      // Students are provisioned by the admin API only.
      allow create: if isAdmin();

        allow update: if signedIn() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'lrn', 'loginMethod', 'createdBy', 'createdAt', 'inactivePeriods', 'deactivatedAt', 'enrollmentStatus', 'enrollmentVersion']) && (
          (isAdmin() && (resource.data.role != 'teacher' ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstName', 'middleName', 'lastName', 'displayName', 'gender', 'title', 'email', 'photoURL']))) ||
          (request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            (resource.data.role != 'teacher' ||
              (!resource.data.keys().hasAny(['gender']) && !request.resource.data.keys().hasAny(['gender'])) ||
              (request.resource.data.gender == 'female' && request.resource.data.title == 'maam') ||
              (request.resource.data.gender == 'male' && request.resource.data.title == 'sir')) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId', 'className', 'joinRequest', 'progressSession', 'skillSummary', 'emailVerificationRequired', 'mustChangePassword', 'verificationSentAt', 'disabled', 'email']))
        );
                                                                                                                                                                                    
        allow delete: if isAdmin();    

      match /assignedLessons/{lessonId} {
        allow read: if signedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (isTeacher() &&
            teachesClass(
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('classId', null)
            ))
        );

        // Answers go to the authenticated assessment API. Scores, resume counts,
        // skill records and completion transitions are calculated by the server.
        allow create, update: if false;
        allow delete: if false;
      }

      // Immutable history is written only by the API, including after a transfer.
      match /classProgress/{classId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || teachesClass(classId));
        allow write: if false;
        match /{document=**} {
          allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || teachesClass(classId));
          allow write: if false;
        }
      }
    }

    function ownsOrShared(d) {
      return signedIn() && (isTeacher() || isAdmin()) &&
        (d.get('teacherId', '') == request.auth.uid || d.get('visibility', 'shared') == 'shared');
    }
    function canReadLesson(d, lessonId) {
      let classId = signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classId', '') : '';
      return ownsOrShared(d) || (canReadLearningContent() && !isTeacher() && !isAdmin() &&
        (d.get('visibility', 'shared') == 'shared' ||
          exists(/databases/$(database)/documents/classes/$(classId)/classLessons/$(lessonId)) ||
          exists(/databases/$(database)/documents/classes/$(classId)/classLessons/$(lessonId + '__practice'))));
    }
    function archiveUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived', 'archivedBy', 'archivedAt', 'archiveReason', 'archiveModerated', 'deletionPending', 'deletionRequestedBy']);
    }
    function noArchiveMetadata() {
      return !request.resource.data.keys().hasAny(['archived', 'archivedBy', 'archivedAt', 'archiveReason', 'archiveModerated', 'deletionPending', 'deletionRequestedBy']);
    }
    // Teachers author their own lessons; premade lessons are copied before editing.
    match /lessons/{lessonId} {
      allow read: if canReadLesson(resource.data, lessonId);
      allow create: if (request.resource.data.get('visibility', 'shared') != 'private' || (request.resource.data.get('teacherId', '') is string && request.resource.data.get('teacherId', '').size() > 0)) && (isAdmin() || request.resource.data.get('adminManaged', false) != true) && noArchiveMetadata() && (!request.resource.data.keys().hasAny(['copiedFromLessonId']) || get(/databases/$(database)/documents/lessons/$(request.resource.data.copiedFromLessonId)).data.get('archived', false) != true) && request.resource.data.get('visibility', 'shared') in ['private', 'shared'] && (isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() > 0));
      allow update: if (isAdmin() || request.resource.data.get('adminManaged', false) == resource.data.get('adminManaged', false)) && (request.resource.data.get('visibility', 'shared') != 'private' || (request.resource.data.get('teacherId', '') is string && request.resource.data.get('teacherId', '').size() > 0)) && archiveUnchanged() && resource.data.get('archived', false) != true && request.resource.data.get('visibility', 'shared') in ['private', 'shared'] && (isAdmin() || (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid &&
        request.resource.data.teacherId == resource.data.teacherId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sourceLessonId', 'copiedFromLessonId', 'createdAt'])));
      allow delete: if false;

      match /{subcollection}/{docId} {
        // Firestore cannot hide individual fields. Students receive sanitized
        // quiz/activity content from the API instead of answer-key documents.
        allow read: if canReadLesson(get(/databases/$(database)/documents/lessons/$(lessonId)).data, lessonId) &&
          (!(subcollection in ['quiz', 'activity']) || isTeacher() || isAdmin());
        allow write: if getAfter(/databases/$(database)/documents/lessons/$(lessonId)).data.get('archived', false) != true && (isAdmin() || (isTeacher() &&
          getAfter(/databases/$(database)/documents/lessons/$(lessonId)).data.get('teacherId', '') == request.auth.uid));
      }
    }

    match /users/{uid}/contentNotices/{noticeId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /contentLifecycleEvents/{eventId} {
      allow read, write: if false;
    }
    match /lessonCopyCounters/{lessonId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update: if (isAdmin() || isTeacher()) &&
        exists(/databases/$(database)/documents/lessons/$(lessonId)) &&
        request.resource.data.keys().hasOnly(['sequence']) &&
        request.resource.data.sequence is int && request.resource.data.sequence > 0 &&
        request.resource.data.sequence <= 1000000 &&
        (resource == null || request.resource.data.sequence == resource.data.sequence + 1);
    }

    match /learningPaths/{pathId} {
      allow read: if isAdmin() || (isTeacher() && (resource.data.ownerId == request.auth.uid || resource.data.visibility == 'shared'));
      // Validated and audited by the authenticated content lifecycle API.
      allow write: if false;
    }

    match /modules/{moduleId} {
      function validModule() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'description', 'lessonIds', 'ownerId', 'visibility', 'revision', 'createdAt', 'updatedAt', 'progression', 'lockingEnabled', 'archived', 'archivedBy', 'archivedAt', 'archiveReason', 'archiveModerated', 'deletionPending', 'deletionRequestedBy']) &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
          d.description is string && d.description.size() <= 1000 &&
          d.lessonIds is list && d.lessonIds.size() > 0 && d.lessonIds.size() <= 100 &&
          d.lessonIds.toSet().size() == d.lessonIds.size() &&
          d.ownerId is string && d.revision is int && d.revision > 0 &&
          d.visibility in ['private', 'shared'] &&
          d.createdAt is timestamp && d.updatedAt == request.time &&
          d.progression == 'sequential' && d.lockingEnabled == false;
      }
      allow read: if (isAdmin() || isTeacher()) && (resource.data.ownerId == request.auth.uid || resource.data.visibility == 'shared');
      allow create: if noArchiveMetadata() && (isAdmin() || isTeacher()) && validModule() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if archiveUnchanged() && resource.data.get('archived', false) != true && (isAdmin() || (isTeacher() && resource.data.ownerId == request.auth.uid)) && validModule() &&
        request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /learnerNumbers/{lrn} {
      allow read, write: if false;
    }

    match /usernames/{username} {
      // Aliases are reserved and resolved only by the password-verifying API.
      allow read, write: if false;
    }

    match /classes/{classId} {
      // Class codes are visible only to staff and already-approved members.
      allow read: if signedIn() && (isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) || isClassMember(classId));

      // Only teachers may create a class, and only with themselves as its teacher.
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.schoolYear is string &&
        request.resource.data.schoolYear.matches('^[0-9]{4}-[0-9]{4}$') &&
        int(request.resource.data.schoolYear.split('-')[1]) == int(request.resource.data.schoolYear.split('-')[0]) + 1 &&
        !request.resource.data.keys().hasAny(['membershipClosed', 'archived', 'archivePeriods', 'classVersion']);

      // Staff can edit class details; archive/restore uses the authenticated lifecycle API.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolYear']) && ((isAdmin() &&
        (request.resource.data.teacherId == resource.data.teacherId || activeClassTeacher(request.resource.data.teacherId))) || (teachesClass(classId) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['membershipClosed', 'archived', 'archivePeriods', 'archivedAt', 'archivedBy', 'classVersion'])));

      // Classes are archived and restored; permanent deletion is unavailable.
      allow delete: if false;

      match /joinRequests/{studentId} {
        allow read: if signedIn() && (teachesClass(classId) || request.auth.uid == studentId);
        // Code validation, approval and rejection use the authenticated API only.
        allow write: if false;
      }

      match /students/{studentId} {
        allow read: if signedIn() &&
          (request.auth.uid == studentId ||
           isAdmin() ||
           teachesClass(classId) || isClassMember(classId));

        // Only server approval can create a roster entry.
        allow create: if false;

        // The student may rename themselves and ask to leave (or cancel); the class's teacher may decline a leave request.
        allow update: if signedIn() && (
          (request.auth.uid == studentId && isClassMember(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'leaveRequest', 'leaveDeclined'])) ||
          (teachesClass(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leaveRequest', 'leaveDeclined']))
        );

        // Leaving only happens when the teacher approves (notify-api/api/remove-student).
        allow delete: if false;
      }

      // Notification list
      match /notifications/{notificationId} {
        allow read: if signedIn() &&
          (teachesClass(classId) || isClassMember(classId));
        allow write: if false;
      }

      // ---------- Class chat: one group chat for the teacher and the class's students ----------
      // messages/{id}   text, senderId, senderName, role ("teacher" | "student"), sentAt;
      //                 a removed message keeps its place: text "", deleted true, deletedBy.
      //                 A join notice ("… joined the class") has kind "join" and text "",
      //                 written by the approval API when the teacher enrolls the student.
      // chat/state      open (missing = open) and a summary of the last message (lastAt,
      //                 lastText, lastSenderName, lastRole), so unread badges cost one read.
      //                 lastRole "join" (text "") after a join notice.
      // chatSenders/{uid}  lastSentAt: a student's last send, for the 5-second limit.
      // A student sends with one batch: the message, chatSenders/{uid} and chat/state.

      function isChatMember(classId) {
        return isClassMember(classId);
      }

      function chatOpen(classId) {
        let state = /databases/$(database)/documents/classes/$(classId)/chat/state;
        return !exists(state) || get(state).data.get('open', true) == true;
      }

      // The student's chatSenders doc is stamped with this request's time in the same batch.
      function sentNow(classId) {
        return getAfter(/databases/$(database)/documents/classes/$(classId)/chatSenders/$(request.auth.uid))
          .data.lastSentAt == request.time;
      }

      function rosterNameAfter(classId) {
        return getAfter(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
          .data.get('fullName', '');
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        // Join notices are written by the approval API in the enrollment transaction.

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'role', 'sentAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.sentAt == request.time &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.senderName is string &&
          (
            (request.resource.data.role == "teacher" &&
              teachesClass(classId) &&
              request.resource.data.text.size() <= 2000 &&
              request.resource.data.senderName.size() <= 80) ||
            (request.resource.data.role == "student" &&
              isChatMember(classId) &&
              chatOpen(classId) &&
              request.resource.data.text.size() <= 300 &&
              request.resource.data.senderName ==
                get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
                  .data.get('fullName', '') &&
              sentNow(classId))
          );

        // Removing: the teacher, any message; a student, their own within 5 minutes.
        allow update: if signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'deletedBy']) &&
          request.resource.data.text == "" &&
          request.resource.data.deleted == true &&
          (
            (teachesClass(classId) && request.resource.data.deletedBy == "teacher") ||
            (resource.data.senderId == request.auth.uid &&
              resource.data.get('kind', '') != "join" &&
              request.resource.data.deletedBy == "sender" &&
              request.time < resource.data.sentAt + duration.value(5, 'm'))
          );

        allow delete: if false;
      }

      match /chat/{stateId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        // The teacher opens/closes the chat and updates the summary when posting.
        allow create, update: if signedIn() && stateId == "state" && (
          (teachesClass(classId) &&
            request.resource.data.keys().hasOnly(['open', 'lastAt', 'lastText', 'lastSenderName', 'lastRole']) &&
            (request.resource.data.get('open', true) is bool)) ||
          // A student only updates the summary, alongside a message (see sentNow).
          (isChatMember(classId) &&
            (resource == null
              ? request.resource.data.keys().hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])) &&
            request.resource.data.lastAt == request.time &&
            request.resource.data.lastRole == "student" &&
            request.resource.data.lastText is string &&
            request.resource.data.lastText.size() <= 300 &&
            chatOpen(classId) &&
            sentNow(classId)) ||
          // A student deleting their own newest message (within the 5 minutes they can) blanks its text, so the teacher's class list says "Message removed".
          (isChatMember(classId) && resource != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText']) &&
            request.resource.data.lastText == "" &&
            resource.data.lastRole == "student" &&
            resource.data.lastSenderName == rosterNameAfter(classId) &&
            request.time < resource.data.lastAt + duration.value(5, 'm'))
        );
        allow delete: if false;
      }

      match /chatSenders/{senderId} {
        allow read: if signedIn() && request.auth.uid == senderId;

        // Stamped with the server's time; at least 5 seconds after the last one.
        allow create, update: if signedIn() &&
          request.auth.uid == senderId &&
          isChatMember(classId) &&
          request.resource.data.keys().hasOnly(['lastSentAt']) &&
          request.resource.data.lastSentAt == request.time &&
          (resource == null || request.time >= resource.data.lastSentAt + duration.value(5, 's'));
        allow delete: if false;
      }

      // Teachers can add an existing lesson only to a class they own. Admins can read them to see which classes use a lesson (lesson editor).
      match /learningPaths/{assignmentId} {
        allow read: if signedIn() && (isAdmin() || teachesClass(classId) || isClassMember(classId));
        allow write: if false;
      }

      match /classLessons/{lessonId} {
        function pathMetadataUnchanged() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['learningPathId', 'learningPathAssignmentId', 'learningPathTitle', 'learningPathModuleOrder', 'learningPathOrder', 'sequenceOpenAt']);
        }
        allow read: if signedIn() &&
          (isAdmin() ||
           teachesClass(classId) || isClassMember(classId));

        allow create: if !request.resource.data.keys().hasAny(['learningPathId', 'learningPathAssignmentId', 'learningPathTitle', 'learningPathModuleOrder', 'learningPathOrder', 'sequenceOpenAt']) && teachesActiveClass(classId) && ownsOrShared(get(/databases/$(database)/documents/lessons/$(request.resource.data.get('lessonId', lessonId))).data) && get(/databases/$(database)/documents/lessons/$(request.resource.data.get('lessonId', lessonId))).data.get('archived', false) != true && (!request.resource.data.keys().hasAny(['moduleId']) || get(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)).data.get('archived', false) != true) && (request.resource.data.get('mode','') == 'practice' || !request.resource.data.keys().hasAny(['deadlineHistory','scheduleChangedAt']));
        allow update: if teachesActiveClass(classId) && pathMetadataUnchanged() && (!resource.data.keys().hasAny(['learningPathAssignmentId']) || request.resource.data.get('mode', 'assessment') == resource.data.get('mode', 'assessment')) && request.resource.data.get('lessonId', lessonId) == resource.data.get('lessonId', lessonId) && (
          (resource.data.get('mode','') == 'practice' && request.resource.data.get('mode','') == 'assessment' && !request.resource.data.keys().hasAny(['deadlineHistory','scheduleChangedAt'])) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openAt', 'dueAt', 'deadlineHistory','scheduleChangedAt']));
        allow delete: if teachesActiveClass(classId);
      }
    }

    match /classLessons/{linkId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid &&
        ownsOrShared(get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data) &&
        get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.get('archived', false) != true;

      allow delete: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow write: if false;
    }

    // Diksiyonaryo: words teachers add or fix (js/dictionary.js). The doc id is the
    // search key; `hidden: true` marks a Wiktionary seed word deleted, and `syllables` ("ba·hay")
    // fixes the automatic syllable split (js/syllables.js). Everyone signed in
    // reads; teachers and admins manage all staff additions, regardless of creator.
    // Imported seed words are read-only in the clients. Legacy hidden markers remain admin-only.
    match /dictionary/{key} {
      function validWord() {
        let d = request.resource.data;
        return d.keys().hasOnly(["word", "key", "accent", "syllables", "senses", "synonyms", "hidden",
            "createdBy", "createdByName", "createdAt", "updatedBy", "updatedByName", "updatedAt",
            "createdByRole", "createdByLastName", "updatedByRole", "updatedByLastName", "edited"]) &&
          (!('createdByRole' in d) || d.createdByRole in ['teacher', 'admin']) &&
          (!('updatedByRole' in d) || d.updatedByRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role) &&
          (!('createdByLastName' in d) || (d.createdByLastName is string && d.createdByLastName.size() <= 120)) &&
          (!('updatedByLastName' in d) || (d.updatedByLastName is string && d.updatedByLastName.size() <= 120)) &&
          (!('edited' in d) || d.edited is bool) &&
          d.word is string && d.word.size() > 0 && d.word.size() <= 60 &&
          d.key == key &&
          d.accent is string && d.accent.size() <= 60 &&
          (!("syllables" in d) || (d.syllables is string && d.syllables.size() <= 120)) &&
          d.senses is list && d.senses.size() <= 5 &&
          (d.hidden || d.senses.size() > 0) &&
          d.synonyms is list && d.synonyms.size() <= 10 &&
          d.hidden is bool && (!d.hidden || isAdmin()) &&
          d.createdByName is string && d.createdByName.size() <= 120 &&
          d.updatedBy == request.auth.uid &&
          d.updatedByName is string && d.updatedByName.size() <= 120 &&
          d.updatedAt == request.time;
      }

      allow read: if signedIn();

      // Admins may also write someone else's createdBy/createdAt: renaming a word moves it to a new doc id and keeps who first added it.
      allow create: if validWord() && (isAdmin() || (isTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time));

      allow update: if validWord() && (isAdmin() || (isTeacher() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt));

      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.hidden == false);
    }

    // adminPasswordChanges (admin password changes waiting for email approval) has no rule on purpose: only notify-api reads and writes it, with the Admin SDK.
  }
}
