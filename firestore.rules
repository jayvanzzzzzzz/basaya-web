rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "teacher";
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "admin";
    }

    function teachesClass(classId) {
      return isTeacher() && classId != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId))
          .data.teacherId == request.auth.uid;
    }

    // Approval is represented by BOTH the server-owned profile link and roster entry.
    function isClassMember(classId) {
      return signedIn() && classId is string && classId != '' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classId', '') == classId &&
        exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid));
    }

    function canReadLearningContent() {
      return signedIn() && (isTeacher() || isAdmin() ||
        isClassMember(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classId', '')));
    }

    // Assessment membership, explicit assignments and server-time schedules are
    // checked by the API; clients cannot write progress directly.

    // The teacher of the class the signed-in student is on the roster of (the chat's member list shows the teacher's name; a removed teacher's doc reads as missing).
    function teachesMyClass(teacherId) {
      let myClass = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('classId', '');
      return myClass is string && myClass != '' &&
        isClassMember(myClass) &&
        get(/databases/$(database)/documents/classes/$(myClass)).data.get('teacherId', '') == teacherId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTeacher() && teachesClass(resource.data.get('classId', null))) ||
        ((resource == null || resource.data.get('role', '') == "teacher") && teachesMyClass(userId))
      );

      allow create: if signedIn() && (                                                                                                                                            
          (request.auth.uid == userId &&                                                                                                                                            
            request.resource.data.role == "student" &&
            request.resource.data.get('classId', '') == '' &&
            request.resource.data.get('className', '') == '' &&
            !request.resource.data.keys().hasAny(['joinRequest', 'progressSession', 'skillSummary'])) ||
          isAdmin()                                                                                                                                                                 
        );                                                                                                                                                                          
                                                                                                                                                                                    
        allow update: if signedIn() && (
          isAdmin() ||
          (request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId', 'className', 'joinRequest', 'progressSession', 'skillSummary']))
        );
                                                                                                                                                                                    
        allow delete: if isAdmin();    

      match /assignedLessons/{lessonId} {
        allow read: if signedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (isTeacher() &&
            teachesClass(
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('classId', null)
            ))
        );

        // Answers go to the authenticated assessment API. Scores, resume counts,
        // skill records and completion transitions are calculated by the server.
        allow create, update: if false;
        allow delete: if false;
      }

      // Immutable history is written only by the API, including after a transfer.
      match /classProgress/{classId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || teachesClass(classId));
        allow write: if false;
        match /{document=**} {
          allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || teachesClass(classId));
          allow write: if false;
        }
      }
    }

    // Staff and approved members can read lessons. Only admins can change lesson content.
    match /lessons/{lessonId} {
      allow read: if canReadLearningContent();
      allow create, update, delete: if isAdmin();

      match /{subcollection}/{docId} {
        // Firestore cannot hide individual fields. Students receive sanitized
        // quiz/activity content from the API instead of answer-key documents.
        allow read: if canReadLearningContent() &&
          (!(subcollection in ['quiz', 'activity']) || isTeacher() || isAdmin());
        allow write: if isAdmin();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
    }

    match /classes/{classId} {
      // Class codes are visible only to staff and already-approved members.
      allow read: if signedIn() && (isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) || isClassMember(classId));

      // Only teachers may create a class, and only with themselves as its teacher.
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      // The class's teacher or an admin can edit it (a teacher also uses this to request deletion: deletionRequest / deletionDeclined fields).
      allow update: if isAdmin() || (teachesClass(classId) &&
        request.resource.data.teacherId == resource.data.teacherId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['membershipClosed']));

      // Never deleted directly: an admin approves, then notify-api/api/delete-class removes the class with its roster, lessons and every student's progress.
      allow delete: if false;

      match /joinRequests/{studentId} {
        allow read: if signedIn() && (teachesClass(classId) || request.auth.uid == studentId);
        // Code validation, approval and rejection use the authenticated API only.
        allow write: if false;
      }

      match /students/{studentId} {
        allow read: if signedIn() &&
          (request.auth.uid == studentId ||
           isAdmin() ||
           teachesClass(classId) || isClassMember(classId));

        // Only server approval can create a roster entry.
        allow create: if false;

        // The student may rename themselves and ask to leave (or cancel); the class's teacher may decline a leave request.
        allow update: if signedIn() && (
          (request.auth.uid == studentId && isClassMember(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'leaveRequest', 'leaveDeclined'])) ||
          (teachesClass(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leaveRequest', 'leaveDeclined']))
        );

        // Leaving only happens when the teacher approves (notify-api/api/remove-student).
        allow delete: if false;
      }

      // Notification list
      match /notifications/{notificationId} {
        allow read: if signedIn() &&
          (teachesClass(classId) || isClassMember(classId));
        allow write: if false;
      }

      // ---------- Class chat: one group chat for the teacher and the class's students ----------
      // messages/{id}   text, senderId, senderName, role ("teacher" | "student"), sentAt;
      //                 a removed message keeps its place: text "", deleted true, deletedBy.
      //                 A join notice ("… joined the class") has kind "join" and text "",
      //                 written by the approval API when the teacher enrolls the student.
      // chat/state      open (missing = open) and a summary of the last message (lastAt,
      //                 lastText, lastSenderName, lastRole), so unread badges cost one read.
      //                 lastRole "join" (text "") after a join notice.
      // chatSenders/{uid}  lastSentAt: a student's last send, for the 5-second limit.
      // A student sends with one batch: the message, chatSenders/{uid} and chat/state.

      function isChatMember(classId) {
        return isClassMember(classId);
      }

      function chatOpen(classId) {
        let state = /databases/$(database)/documents/classes/$(classId)/chat/state;
        return !exists(state) || get(state).data.get('open', true) == true;
      }

      // The student's chatSenders doc is stamped with this request's time in the same batch.
      function sentNow(classId) {
        return getAfter(/databases/$(database)/documents/classes/$(classId)/chatSenders/$(request.auth.uid))
          .data.lastSentAt == request.time;
      }

      function rosterNameAfter(classId) {
        return getAfter(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
          .data.get('fullName', '');
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        // Join notices are written by the approval API in the enrollment transaction.

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'role', 'sentAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.sentAt == request.time &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.senderName is string &&
          (
            (request.resource.data.role == "teacher" &&
              teachesClass(classId) &&
              request.resource.data.text.size() <= 2000 &&
              request.resource.data.senderName.size() <= 80) ||
            (request.resource.data.role == "student" &&
              isChatMember(classId) &&
              chatOpen(classId) &&
              request.resource.data.text.size() <= 300 &&
              request.resource.data.senderName ==
                get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
                  .data.get('fullName', '') &&
              sentNow(classId))
          );

        // Removing: the teacher, any message; a student, their own within 5 minutes.
        allow update: if signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'deletedBy']) &&
          request.resource.data.text == "" &&
          request.resource.data.deleted == true &&
          (
            (teachesClass(classId) && request.resource.data.deletedBy == "teacher") ||
            (resource.data.senderId == request.auth.uid &&
              resource.data.get('kind', '') != "join" &&
              request.resource.data.deletedBy == "sender" &&
              request.time < resource.data.sentAt + duration.value(5, 'm'))
          );

        allow delete: if false;
      }

      match /chat/{stateId} {
        allow read: if signedIn() && (teachesClass(classId) || isChatMember(classId));

        // The teacher opens/closes the chat and updates the summary when posting.
        allow create, update: if signedIn() && stateId == "state" && (
          (teachesClass(classId) &&
            request.resource.data.keys().hasOnly(['open', 'lastAt', 'lastText', 'lastSenderName', 'lastRole']) &&
            (request.resource.data.get('open', true) is bool)) ||
          // A student only updates the summary, alongside a message (see sentNow).
          (isChatMember(classId) &&
            (resource == null
              ? request.resource.data.keys().hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])
              : request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastAt', 'lastText', 'lastSenderName', 'lastRole'])) &&
            request.resource.data.lastAt == request.time &&
            request.resource.data.lastRole == "student" &&
            request.resource.data.lastText is string &&
            request.resource.data.lastText.size() <= 300 &&
            chatOpen(classId) &&
            sentNow(classId)) ||
          // A student deleting their own newest message (within the 5 minutes they can) blanks its text, so the teacher's class list says "Message removed".
          (isChatMember(classId) && resource != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText']) &&
            request.resource.data.lastText == "" &&
            resource.data.lastRole == "student" &&
            resource.data.lastSenderName == rosterNameAfter(classId) &&
            request.time < resource.data.lastAt + duration.value(5, 'm'))
        );
        allow delete: if false;
      }

      match /chatSenders/{senderId} {
        allow read: if signedIn() && request.auth.uid == senderId;

        // Stamped with the server's time; at least 5 seconds after the last one.
        allow create, update: if signedIn() &&
          request.auth.uid == senderId &&
          isChatMember(classId) &&
          request.resource.data.keys().hasOnly(['lastSentAt']) &&
          request.resource.data.lastSentAt == request.time &&
          (resource == null || request.time >= resource.data.lastSentAt + duration.value(5, 's'));
        allow delete: if false;
      }

      // Teachers can add an existing lesson only to a class they own. Admins can read them to see which classes use a lesson (lesson editor).
      match /classLessons/{lessonId} {
        allow read: if signedIn() &&
          (isAdmin() ||
           teachesClass(classId) || isClassMember(classId));

        allow write: if teachesClass(classId);
      }
    }

    match /classLessons/{linkId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      allow delete: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow write: if false;
    }

    // Diksiyonaryo: words teachers add or fix (js/dictionary.js). The doc id is the
    // search key; `hidden: true` marks a Wiktionary seed word deleted, and `syllables` ("ba·hay")
    // fixes the automatic syllable split (js/syllables.js). Everyone signed in
    // reads, any teacher or admin adds/edits, and only whoever added a word (or an
    // admin) deletes it. Only admins write or remove a "hidden" (deleted) marker.
    match /dictionary/{key} {
      function validWord() {
        let d = request.resource.data;
        return d.keys().hasOnly(["word", "key", "accent", "syllables", "senses", "synonyms", "hidden",
            "createdBy", "createdByName", "createdAt", "updatedBy", "updatedByName", "updatedAt"]) &&
          d.word is string && d.word.size() > 0 && d.word.size() <= 60 &&
          d.key == key &&
          d.accent is string && d.accent.size() <= 60 &&
          (!("syllables" in d) || (d.syllables is string && d.syllables.size() <= 120)) &&
          d.senses is list && d.senses.size() <= 5 &&
          (d.hidden || d.senses.size() > 0) &&
          d.synonyms is list && d.synonyms.size() <= 10 &&
          d.hidden is bool && (!d.hidden || isAdmin()) &&
          d.createdByName is string && d.createdByName.size() <= 120 &&
          d.updatedBy == request.auth.uid &&
          d.updatedByName is string && d.updatedByName.size() <= 120 &&
          d.updatedAt == request.time;
      }

      allow read: if signedIn();

      // Admins may also write someone else's createdBy/createdAt: renaming a word moves it to a new doc id and keeps who first added it.
      allow create: if validWord() && (isAdmin() || (isTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time));

      allow update: if validWord() && (isAdmin() || (isTeacher() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt));

      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid && resource.data.hidden == false);
    }

    // adminPasswordChanges (admin password changes waiting for email approval) has no rule on purpose: only notify-api reads and writes it, with the Admin SDK.
  }
}
