rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "teacher";
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "admin";
    }

    function teachesClass(classId) {
      return classId != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId))
          .data.teacherId == request.auth.uid;
    }

    // Lesson schedule: the teacher's optional openAt/dueAt on
    // classes/{classId}/classLessons/{lessonId}. Judged by server time
    // (request.time), so changing the phone's date does not help.
    function scheduleAllows(link) {
      return (link.get('openAt', null) == null || request.time >= link.openAt) &&
        (link.get('dueAt', null) == null || request.time <= link.dueAt);
    }

    function classLessonAllows(classId, lessonId) {
      let path = /databases/$(database)/documents/classes/$(classId)/classLessons/$(lessonId);
      // Older links have auto-generated ids and no schedule.
      return !exists(path) || scheduleAllows(get(path).data);
    }

    function lessonIsOpen(userId, lessonId) {
      let classId = get(/databases/$(database)/documents/users/$(userId))
        .data.get('classId', null);
      return classId == null || classId == "" || classLessonAllows(classId, lessonId);
    }

    // A student can't switch or leave a class while still on its roster: leaving needs the
    // teacher's approval (notify-api/api/remove-student clears classId).
    function classChangeAllowed(userId) {
      let before = resource.data.get('classId', null);
      let after = request.resource.data.get('classId', null);
      return before == after || before == null || before == "" ||
        !exists(/databases/$(database)/documents/classes/$(before)/students/$(userId));
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTeacher() && teachesClass(resource.data.get('classId', null)))
      );

      allow create: if signedIn() && (                                                                                                                                            
          (request.auth.uid == userId &&                                                                                                                                            
            request.resource.data.role == "student") ||                                                                                                                             
          isAdmin()                                                                                                                                                                 
        );                                                                                                                                                                          
                                                                                                                                                                                    
        allow update: if signedIn() && (
          isAdmin() ||
          (request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            classChangeAllowed(userId))
        );
                                                                                                                                                                                    
        allow delete: if isAdmin();    

      match /assignedLessons/{lessonId} {
        allow read: if signedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (isTeacher() &&
            teachesClass(
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('classId', null)
            ))
        );

        // Progress is rejected before the lesson opens and after its deadline.
        allow write: if signedIn() && request.auth.uid == userId &&
          lessonIsOpen(userId, lessonId);
      }
    }

    // All authenticated users can read lessons.
    // Only administrators can create, edit, or delete lessons
    // and their activity/lectures/pronunciation/quiz/game content.
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
    }

    match /classes/{classId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.teacherId == request.auth.uid;

      // The class's teacher or an admin can edit it (a teacher also uses this to
      // request deletion: deletionRequest / deletionDeclined fields).
      allow update: if signedIn() &&
        (resource.data.teacherId == request.auth.uid || isAdmin());

      // Never deleted directly: an admin approves, then notify-api/api/delete-class
      // removes the class with its roster, lessons and every student's progress.
      allow delete: if false;

      match /students/{studentId} {
        allow read: if signedIn() &&
          (request.auth.uid == studentId ||
           isAdmin() ||
           get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));

        // Joining: a student adds themselves.
        allow create: if signedIn() && request.auth.uid == studentId;

        // The student may rename themselves and ask to leave (or cancel); the class's
        // teacher may decline a leave request.
        allow update: if signedIn() && (
          (request.auth.uid == studentId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'joinedAt', 'leaveRequest', 'leaveDeclined'])) ||
          (teachesClass(classId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['leaveRequest', 'leaveDeclined']))
        );

        // Leaving only happens when the teacher approves (notify-api/api/remove-student).
        allow delete: if false;
      }

      // Notification list ("new lesson"), written only by notify-api (Admin SDK).
      match /notifications/{notificationId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));
        allow write: if false;
      }

      // Teachers can add an existing lesson only to a class they own.
      match /classLessons/{lessonId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/classes/$(classId))
             .data.teacherId == request.auth.uid ||
           exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)));

        allow write: if signedIn() &&
          get(/databases/$(database)/documents/classes/$(classId))
            .data.teacherId == request.auth.uid;
      }
    }

    match /classLessons/{linkId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      allow delete: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isTeacher() &&
        resource.data.teacherId == request.auth.uid;

      allow write: if false;
    }
  }
}